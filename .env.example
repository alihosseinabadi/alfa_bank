# ---------------------------------------------------------------------------
# Alfa-Kurs — environment template
# Copy to .env and export it in the shell before launching the API/migrations.
# Docker Compose reads the root .env; the API also reads backend/.env.
# Never commit either file.
# ---------------------------------------------------------------------------

# --- Database ---------------------------------------------------------------
POSTGRES_USER=alfakurs
POSTGRES_PASSWORD=change_me
POSTGRES_DB=alfakurs
POSTGRES_HOST=localhost
POSTGRES_PORT=55438

# Async/sync SQLAlchemy URL used by the backend
DATABASE_URL=postgresql+psycopg://alfakurs:change_me@localhost:55438/alfakurs

# --- API --------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
API_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Generate a unique secret with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Keep the same secret across restarts and never commit the real value.
ALFA_SESSION_SECRET=
# Set false only for local HTTP development. Use true with HTTPS.
ALFA_SESSION_COOKIE_SECURE=true

# --- ML serving (requires a locally prepared catalog, index and migrated events DB) ---
ALFA_RECOMMENDATIONS_ENABLED=false
# Fast simulated learning requires ALFA_EVENTS_DATABASE_URL to name alfa_events_test.
ALFA_DEMO_FAST_LEARNING=false
ALFA_CATALOG_DIR=data/processed/catalog
ALFA_RETRIEVAL_INDEX_DIR=artifacts/retrieval

# --- Legacy experiment settings (not used to configure the serving provider) --
# Serving currently uses the existing BM25 defaults; rebuilding indexes may use these as documentation only.
# tfidf | embedding
RETRIEVER=tfidf
RETRIEVAL_K=50
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# --- Legacy LinUCB example settings (not read by the serving provider) -------
# The current LearningService uses its own defaults: alpha=0.5, ridge=1.0.
# Exploration strength. Larger = more exploration.
LINUCB_ALPHA=1.0
# Ridge term keeping A positive definite.
LINUCB_RIDGE=0.01
# Context vector layout version. Changing features requires bumping this.
FEATURE_VERSION=v1
# Directory for saved model artifacts.
MODEL_DIR=artifacts

# --- Legacy backend settings (not used by ML reward-v1) ---------------------
REWARD_CLICK=1.0
REWARD_INSPECT=1.0
REWARD_PURCHASE=10.0
# A purchase may reference an impression up to this many days old.
PURCHASE_ATTRIBUTION_DAYS=7

# --- Experiments ------------------------------------------------------------
# At least 10 seeds: the evaluation reports mean and 95% CI across seeds.
EXPERIMENT_SEEDS=10
EXPERIMENT_USERS=200
EXPERIMENT_ROUNDS=50
EXPERIMENT_SEED_BASE=42

# --- Frontend ---------------------------------------------------------------
VITE_API_BASE_URL=http://127.0.0.1:8000

# --- Stage-7 separate event databases (export explicitly; local demo only) ----
ALFA_EVENTS_DATABASE_URL=postgresql+psycopg://alfa_events:local_events_only@127.0.0.1:55437/alfa_events
ALFA_EVENTS_TEST_DATABASE_URL=postgresql+psycopg://alfa_events:local_events_only@127.0.0.1:55437/alfa_events_test