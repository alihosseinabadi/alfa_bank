# ---------------------------------------------------------------------------
# Alfa-Kurs - environment template
# Copy to .env and fill real values. Never commit .env.
#
# Every value below mirrors a real default in the code (Phase 0 housekeeping).
# Source of truth: backend/app/ml/reward_policy.py (rewards),
#                  backend/app/services/learning_service.py (ridge/alpha),
#                  backend/app/ml/retrieval_contracts.py (retrieval),
#                  backend/app/ml/ranking_contracts.py (feature version).
# ---------------------------------------------------------------------------

# --- Database ---------------------------------------------------------------
POSTGRES_USER=alfakurs
POSTGRES_PASSWORD=change_me
POSTGRES_DB=alfakurs
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Async/sync SQLAlchemy URL used by the backend
DATABASE_URL=postgresql+psycopg://alfakurs:change_me@localhost:5432/alfakurs

# --- API --------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
API_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- ML: retrieval ----------------------------------------------------------
# tfidf | bm25 | e5 (e5 additionally requires local weights and vectors).
RETRIEVER=tfidf
RETRIEVAL_K=50
# Optional semantic channel. E5 is not downloaded automatically and is disabled
# unless the model directory exists locally.
EMBEDDING_MODEL=intfloat/multilingual-e5-base
E5_MODEL_DIR=

# --- ML: LinUCB -------------------------------------------------------------
# Exploration strength. Larger = more exploration. Code default: 0.5.
LINUCB_ALPHA=0.5
# Ridge term keeping A positive definite. Code default: 1.0.
LINUCB_RIDGE=1.0
# Context vector layout version. Must match backend/app/ml/ranking_contracts.py.
FEATURE_VERSION=pair-features-v1
# Directory for saved model artifacts.
MODEL_DIR=artifacts

# --- ML: reward weights -----------------------------------------------------
# Bounded reward in [0, 1], ordered click <= free open <= purchase.
REWARD_CLICK=0.1
REWARD_INSPECT=0.15
REWARD_PURCHASE=1.0
# Rewards are only computed after this many seconds (code default: 86400).
REWARD_MATURITY_SECONDS=86400
# A purchase may reference an impression up to this many days old.
PURCHASE_ATTRIBUTION_DAYS=7
# Purchases only count when a payment server verifies them. Off by default.
ALLOW_VERIFIED_PAYMENTS=false

# --- Experiments ------------------------------------------------------------
# At least 10 seeds: the evaluation reports mean and 95% CI across seeds.
EXPERIMENT_SEEDS=10
EXPERIMENT_USERS=200
EXPERIMENT_ROUNDS=50
EXPERIMENT_SEED_BASE=42

# --- Frontend ---------------------------------------------------------------
VITE_API_BASE_URL=http://127.0.0.1:8000

# --- Stage-7 isolated product events (local demo only) ------------------------
ALFA_EVENTS_DATABASE_URL=postgresql+psycopg://alfa_events:local_events_only@127.0.0.1:55437/alfa_events
ALFA_EVENTS_TEST_DATABASE_URL=postgresql+psycopg://alfa_events:local_events_only@127.0.0.1:55437/alfa_events_test
